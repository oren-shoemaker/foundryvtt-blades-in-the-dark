    {
      "name": "Visions of a Phantom Realm",
      "type": "spell",
      "_id": "VzB9rSR354e8aQfs",
      "img": "icons/svg/item-bag.svg",
      "system": {
        "description": "<p><span id=\"docs-internal-guid-3d50400c-7fff-d341-9995-44360ff06785\">Bring forth a visual and/or auditory illusion that can occupy a space up to twenty feet in any dimension, centered on a location that you can see within two hundred feet. It stands up to close inspection, but not to physical touch. It disappears after ten minutes, or if you dismiss it.</span></p>",
        "stress": 4
      },
      "effects": [],
      "folder": null,
      "sort": 0,
      "flags": {},
