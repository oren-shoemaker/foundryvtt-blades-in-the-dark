    {
      "name": "Beckoning Flame",
      "type": "spell",
      "_id": "QFUPwnJVupRojsLK",
      "img": "icons/svg/item-bag.svg",
      "system": {
        "description": "<p><span id=\"docs-internal-guid-1f1416c5-7fff-42ad-e15d-1c12513f923c\">Conjure a flash of fire in a sphere, cone, or cylinder whose dimensions are no less than ten feet and no more than fifty. A cone conjured this way emanates from your body. A sphere or cylinder conjured this way may emanate from any point that you can see within one hundred feet of your location. Flammable objects in the area are ignited and flesh is badly burned.</span></p>",
        "stress": 4
      },
      "effects": [],
