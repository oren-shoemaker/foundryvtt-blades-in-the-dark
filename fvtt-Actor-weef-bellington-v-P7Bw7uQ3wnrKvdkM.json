    {
      "name": "Sentinel of the Curtain",
      "type": "class",
      "_id": "UBbBsgjF5OCrRLLV",
      "img": "icons/svg/item-bag.svg",
      "system": {
        "description": "<p><span id=\"docs-internal-guid-232baaf5-7fff-d359-f597-3c579a56931d\">The Sentinel of the Curtain is trained to take part in direct combat, to lead a squad or militia against a foe, and to endure great hardships. Play a Sentinel if you want to spit in the eye of corruption as you fight a horde of vile monstrosities from dawn to dusk with your comrades at your back.</span></p>",
        "logic": "",
