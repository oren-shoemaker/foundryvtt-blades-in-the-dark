    },
    {
      "name": "Unseemly Passage",
      "type": "spell",
      "_id": "WJG5hcZVn1wX0sok",
      "img": "icons/svg/item-bag.svg",
      "system": {
        "description": "<p><span id=\"docs-internal-guid-39d702bf-7fff-e73b-0009-6400388851c5\">You create a stable passage through solid, nonliving matter. It can be up to fifty feet long and ten feet wide. It is stable for an hour or so, after which it may collapse under its own weight (depending on the material).</span></p>",
        "stress": 4
      },
